# ============================================================
#  Copie para ".env" e preencha. Sem MP_ACCESS_TOKEN = modo MOCK.
# ============================================================

# ---- Produto ----
PRODUTO_NOME=Cronograma de Transformacao Capilar - Reveillon
PRECO=29.90

# ---- Mercado Pago (deixe vazio para testar em modo simulado) ----
# Credenciais em: https://www.mercadopago.com.br/developers > Suas integracoes > Credenciais
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---- URL publica do backend (notification_url do Pix) ----
# Local: http://localhost:8000  | Produção: https://seu-app.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# ---- CORS (frontend). "*" em dev; em prod a origem exata ----
CORS_ORIGINS=*

# ---- E-mail automatico apos pagamento (opcional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
